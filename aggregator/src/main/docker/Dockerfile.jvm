####
# Container image for the aggregator, running the Quarkus application in JVM mode.
#
# Build the application first, then the image:
#
#   ./mvnw package
#   docker build -f src/main/docker/Dockerfile.jvm -t spoud/kafka-cost-control .
#
# Run it with:
#
#   docker run -i --rm -p 8080:8080 spoud/kafka-cost-control
#
# The base is Chainguard's minimal JRE: no shell and no package manager, fewer CVEs, and a fresh JDK
# with every digest bump (Dependabot updates the pinned digest). There is no run-java.sh, so:
# - JVM flags: the entrypoint keeps the GC flags the previous UBI image's run-java.sh used. Pass more
#   with JDK_JAVA_OPTIONS (read by the java launcher), e.g. -e JDK_JAVA_OPTIONS="-XX:+UseZGC".
# - Heap size: JAVA_TOOL_OPTIONS sets -XX:MaxRAMPercentage (default 80, as before). Override the whole
#   variable to change it, e.g. -e JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=50.0".
#   JAVA_OPTS, JAVA_OPTS_APPEND and JAVA_MAX_MEM_RATIO are no longer read.
# - Debugging: -e JDK_JAVA_OPTIONS="-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005"
#   and publish port 5005.
#
# Runs as UID/GID 185 from /deployments, like the previous image, so existing securityContexts
# (runAsUser/fsGroup 185), volume mounts and the mounted config/ directory keep working.
###
FROM cgr.dev/chainguard/jre:latest@sha256:cb0441ab64307b684825a6a3b13caed5bbe13c5684c840b3c90ecab117d3ee1f

ENV LANG='en_US.UTF-8' LANGUAGE='en_US:en'
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=80.0"

WORKDIR /deployments

# We make four distinct layers so if there are application changes the library layers can be re-used
COPY --chown=185:185 target/quarkus-app/lib/ /deployments/lib/
COPY --chown=185:185 target/quarkus-app/*.jar /deployments/
COPY --chown=185:185 target/quarkus-app/app/ /deployments/app/
COPY --chown=185:185 target/quarkus-app/quarkus/ /deployments/quarkus/

EXPOSE 8080
USER 185

ENTRYPOINT [ "java", \
  "-XX:+UseParallelGC", "-XX:MinHeapFreeRatio=10", "-XX:MaxHeapFreeRatio=20", "-XX:GCTimeRatio=4", \
  "-XX:AdaptiveSizePolicyWeight=90", "-XX:+ExitOnOutOfMemoryError", \
  "-Dquarkus.http.host=0.0.0.0", "-Djava.util.logging.manager=org.jboss.logmanager.LogManager", \
  "-jar", "/deployments/quarkus-run.jar" ]
