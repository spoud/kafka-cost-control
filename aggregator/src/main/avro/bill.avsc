{
  "namespace": "io.spoud.kcc.data",
  "type": "record",
  "name": "Bill",
  "doc": "What the provider billed for one calendar month (UTC), per line. Keyed by month, e.g. 2026-09.",
  "fields": [
    {
      "name": "month",
      "doc": "The billed month, yyyy-MM.",
      "type": "string"
    },
    {
      "name": "covered_until",
      "doc": "End (exclusive) of what the amounts cover, for a month-to-date bill. Absent means the whole month.",
      "type": ["null", {"type": "long", "logicalType": "timestamp-millis"}],
      "default": null
    },
    {
      "name": "network_write",
      "doc": "Amount billed for network write (produce, request bytes). Absent: not on this bill.",
      "type": ["null", "double"],
      "default": null
    },
    {
      "name": "network_read",
      "doc": "Amount billed for network read (consume, response bytes).",
      "type": ["null", "double"],
      "default": null
    },
    {
      "name": "storage",
      "doc": "Amount billed for storage.",
      "type": ["null", "double"],
      "default": null
    },
    {
      "name": "partitions",
      "doc": "Amount billed for partitions.",
      "type": ["null", "double"],
      "default": null
    },
    {
      "name": "other",
      "doc": "Everything else on the bill (connectors, support, credits as a negative amount): shown as platform / shared, not split by usage.",
      "type": ["null", "double"],
      "default": null
    },
    {
      "name": "updated_at",
      "type": {"type": "long", "logicalType": "timestamp-millis"}
    },
    {
      "name": "updated_by",
      "doc": "Who saved it, e.g. the signed-in user's e-mail.",
      "type": ["null", "string"],
      "default": null
    }
  ]
}
