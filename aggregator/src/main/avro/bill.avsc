{
  "namespace": "io.spoud.kcc.data",
  "type": "record",
  "name": "Bill",
  "doc": "What the provider billed for one calendar month (UTC), per line. Keyed by month, e.g. 2026-09.",
  "fields": [
    {
      "name": "month",
      "doc": "The billed month, yyyy-MM.",
      "type": "string"
    },
    {
      "name": "covered_until",
      "doc": "End (exclusive) of what the amounts cover, for a month-to-date bill. Absent means the whole month.",
      "type": ["null", {"type": "long", "logicalType": "timestamp-millis"}],
      "default": null
    },
    {
      "name": "network_write",
      "doc": "Amount billed for network write (produce, request bytes). Absent: not on this bill.",
      "type": ["null", "double"],
      "default": null
    },
    {
      "name": "network_read",
      "doc": "Amount billed for network read (consume, response bytes).",
      "type": ["null", "double"],
      "default": null
    },
    {
      "name": "storage",
      "doc": "Amount billed for storage.",
      "type": ["null", "double"],
      "default": null
    },
    {
      "name": "partitions",
      "doc": "Amount billed for partitions.",
      "type": ["null", "double"],
      "default": null
    },
    {
      "name": "other_lines",
      "doc": "Everything else on the bill (connectors, support, credits as a negative amount), line by line, each with where it goes.",
      "type": {
        "type": "array",
        "items": {
          "type": "record",
          "name": "BillOtherLine",
          "fields": [
            {"name": "description", "type": "string"},
            {"name": "amount", "type": "double"},
            {
              "name": "allocation",
              "doc": "CONTEXT: all of it to the given context; USAGE: spread in proportion to the month's usage-based costs; SHARED: shown as shared, not assigned to anyone.",
              "type": "string"
            },
            {
              "name": "context",
              "doc": "For CONTEXT: the context the amount belongs to, e.g. tenant=data-platform.",
              "type": ["null", {"type": "map", "values": "string"}],
              "default": null
            }
          ]
        }
      },
      "default": []
    },
    {
      "name": "updated_at",
      "type": {"type": "long", "logicalType": "timestamp-millis"}
    },
    {
      "name": "updated_by",
      "doc": "Who saved it, e.g. the signed-in user's e-mail.",
      "type": ["null", "string"],
      "default": null
    }
  ]
}
