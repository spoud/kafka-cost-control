{
  "namespace": "io.spoud.kcc.data",
  "type": "record",
  "name": "PricingRule",
  "fields": [
    {
      "name": "creation_time",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    },
    {
      "name": "metric_name",
      "type": "string"
    },
    {
      "name": "base_cost",
      "doc": "The cost that will be added no matter what to each metric. It should usually be at zero. The final cost will be  base_cost + cost_factor * metric_value",
      "type": "double"
    },
    {
      "name": "cost_factor",
        "doc": "The cost that will be multiplied by the metric value. The final cost will be  base_cost + cost_factor * metric_value",
      "type": "double"
    },
    {
      "name": "price",
      "doc": "The price as entered, per price_unit. When set, cost_factor is derived from it: price * multiplier / bytes-per-unit. Absent on rules saved with a bare cost_factor.",
      "type": ["null", "double"],
      "default": null
    },
    {
      "name": "price_unit",
      "doc": "What price is per: GB (2^30 bytes), GB_HOUR (2^30 bytes held for one hourly window) or UNIT (one unit of the metric's value).",
      "type": ["null", "string"],
      "default": null
    },
    {
      "name": "multiplier",
      "doc": "Factor applied on top of price, e.g. 3 for storage billed per replica. Absent means 1.",
      "type": ["null", "double"],
      "default": null
    },
    {
      "name": "multiplier_label",
      "doc": "What the multiplier stands for, e.g. replicas. Display only.",
      "type": ["null", "string"],
      "default": null
    },
    {
      "name": "valid_from",
      "doc": "When the current price (the fields above) started. Absent: it has always applied.",
      "type": ["null", {"type": "long", "logicalType": "timestamp-millis"}],
      "default": null
    },
    {
      "name": "earlier_prices",
      "doc": "The prices before the current one, oldest first; each applies from valid_from (absent: always) until valid_until.",
      "type": {
        "type": "array",
        "items": {
          "type": "record",
          "name": "PricePeriod",
          "fields": [
            {"name": "valid_from", "type": ["null", {"type": "long", "logicalType": "timestamp-millis"}], "default": null},
            {"name": "valid_until", "type": {"type": "long", "logicalType": "timestamp-millis"}},
            {"name": "base_cost", "type": "double"},
            {"name": "cost_factor", "type": "double"},
            {"name": "price", "type": ["null", "double"], "default": null},
            {"name": "price_unit", "type": ["null", "string"], "default": null},
            {"name": "multiplier", "type": ["null", "double"], "default": null},
            {"name": "multiplier_label", "type": ["null", "string"], "default": null}
          ]
        }
      },
      "default": []
    }
  ]
}
