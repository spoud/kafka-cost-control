INPUT_CONFLUENT_METRICS_API_KEY=ccloud-metric-api-key
INPUT_CONFLUENT_METRICS_API_SECRET=ccloud-metric-api-secret
# one URL; repeat resource.kafka.id for more clusters (...?resource.kafka.id=lkc-a&resource.kafka.id=lkc-b).
# The metric parameters ask Confluent only for what costs are built from (Telegraf keeps only these anyway).
INPUT_URL=https://api.telemetry.confluent.cloud/v2/metrics/cloud/export?resource.kafka.id=CLUSTER_ID&metric=io.confluent.kafka.server/request_bytes&metric=io.confluent.kafka.server/response_bytes&metric=io.confluent.kafka.server/retained_bytes&metric=io.confluent.kafka.server/partition_count&metric=io.confluent.kafka.server/received_bytes&metric=io.confluent.kafka.server/sent_bytes

OUTPUT_BROKER=instance.provider.confluent.cloud:9092
OUTPUT_TOPIC=metrics-raw-telegraf-dev
OUTPUT_KAFKA_SASL_USERNAME=ccloud-username
OUTPUT_KAFKA_SASL_PASSWORD=ccloud-password

ENVIRONMENT_NAME=dev

